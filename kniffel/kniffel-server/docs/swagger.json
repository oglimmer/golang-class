{
    "swagger": "2.0",
    "info": {
        "description": "Kniffel as a service - KaaS",
        "title": "Kniffel Game API",
        "contact": {},
        "license": {
            "name": "Apache 2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0"
        },
        "version": "0.0.1"
    },
    "paths": {
        "/api/v1/game/": {
            "post": {
                "description": "The number of players must be at least 2. All player names must be different.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "game"
                ],
                "summary": "Create a new game with a specific number of players",
                "parameters": [
                    {
                        "description": "Game creation request",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.CreateGameRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/model.GameResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/game/{gameId}": {
            "get": {
                "description": "Retrieve the current state of a game",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "game"
                ],
                "summary": "Get game information",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Game ID",
                        "name": "gameId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.GameResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/game/{gameId}/book": {
            "post": {
                "description": "Book the current dice roll into a scoring category",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "game"
                ],
                "summary": "Book a dice roll",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Game ID",
                        "name": "gameId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Booking type",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.BookRollRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.GameResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/game/{gameId}/roll": {
            "post": {
                "description": "Re-roll dice that the player doesn't want to keep",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "game"
                ],
                "summary": "Re-roll dice",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Game ID",
                        "name": "gameId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Dice to keep",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.DiceRollRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.GameResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/server/goroutine-dump": {
            "post": {
                "description": "Prints all goroutine stack traces to stdout",
                "tags": [
                    "server"
                ],
                "summary": "Dump goroutine stack traces",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/v1/server/status": {
            "get": {
                "description": "Returns server time, version and status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "server"
                ],
                "summary": "Get server status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.ServerStatus"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.ServerStatus": {
            "type": "object",
            "properties": {
                "serverName": {
                    "type": "string"
                },
                "serverStatus": {
                    "type": "string"
                },
                "serverTime": {
                    "type": "integer"
                },
                "serverVersion": {
                    "type": "string"
                }
            }
        },
        "model.BookRollRequest": {
            "type": "object",
            "properties": {
                "bookingType": {
                    "type": "string"
                }
            }
        },
        "model.CreateGameRequest": {
            "type": "object",
            "properties": {
                "playerNames": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.DiceRollRequest": {
            "type": "object",
            "properties": {
                "diceToKeep": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "model.GameResponse": {
            "type": "object",
            "properties": {
                "availableBookingTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "currentPlayerName": {
                    "type": "string"
                },
                "diceRolls": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "gameId": {
                    "type": "string"
                },
                "playerData": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.PlayerData"
                    }
                },
                "rollRound": {
                    "type": "integer"
                },
                "state": {
                    "type": "string"
                },
                "usedBookingTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.PlayerData": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "score": {
                    "type": "integer"
                }
            }
        }
    },
    "externalDocs": {
        "description": "Kniffel Regeln",
        "url": "https://www.schmidtspiele.de/files/Produkte/4/49030%20-%20Kniffel/49203_49030_Kniffel_DE.pdf"
    }
}